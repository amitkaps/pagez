{
  "name": "@amitkaps/pagez",
  "version": "0.3.0",
  "description": "pagez — Markdown, as pages.",
  "homepage": "https://pagez.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/pagez.git"
  },
  "bin": {
    "pagez": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/pages.md",
    "docs/elements.md",
    "docs/usage.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test --run",
    "size": "node tests/speed/size.ts",
    "speed": "node tests/speed/speed.ts",
    "hotspots": "node tests/speed/speed.ts --profile",
    "prose": "prose",
    "verify": "pnpm check && pnpm prose check && pnpm prose outline && pnpm craftz check && pnpm test && pnpm build && pnpm size && pnpm prose build",
    "pr": "craftz pr",
    "gone": "craftz gone",
    "craftz": "craftz",
    "ship": "craftz deploy"
  },
  "devDependencies": {
    "@amitkaps/craftz": "0.10.0",
    "@amitkaps/markz": "0.9.0",
    "@amitkaps/prose": "0.11.0",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "vite-plus": "^1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.12.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
