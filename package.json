{
  "name": "@amitkaps/pagez",
  "version": "0.1.0",
  "description": "pagez — Markdown, as pages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/pagez.git"
  },
  "bin": {
    "pagez": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test --run",
    "prose": "prose",
    "verify": "pnpm check && pnpm prose check && pnpm test && pnpm build",
    "pr": "craftz pr",
    "gone": "craftz gone",
    "craftz": "craftz"
  },
  "devDependencies": {
    "@amitkaps/craftz": "^0.1.2",
    "@amitkaps/markz": "^0.6.0",
    "@amitkaps/prose": "^0.8.0",
    "@types/node": "^26.6.5",
    "happy-dom": "21.0.3",
    "publint": "^0.3.25",
    "vite-plus": "1.3.0"
  },
  "peerDependencies": {
    "vite-plus": "^1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.13.0"
}
