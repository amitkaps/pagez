{
  "name": "@amitkaps/pagez",
  "version": "0.0.0",
  "description": "pagez — one Markdown page, one HTML file.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/pagez.git"
  },
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reset.css": "./css/reset.css",
    "./prose.css": "./css/prose.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test --run",
    "prose": "prose",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@amitkaps/prose": "^0.4.1",
    "@types/node": "^26.6.4",
    "happy-dom": "20.14.5",
    "publint": "^0.3.25",
    "vite-plus": "1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1"
}
